{
  "name": "shuka-marketplace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "migrate": "node server/migrate.js",
    "seed": "node server/seed.js",
    "backup": "node server/backup.js",
    "build:client": "npm --prefix client run build",
    "build": "npm --prefix client install && npm --prefix client run build",
    "dev:server": "node --watch server/index.js",
    "dev:client": "npm --prefix client run dev",
    "start": "node server/index.js",
    "test:break-it": "node tests/break-it.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.2.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  }
}
